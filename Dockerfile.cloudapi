FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Keep restore inputs separate from source so a normal source edit reuses the expensive
# NuGet restore layer. The project files are copied to their original paths because project
# references are resolved during restore.
COPY global.json Directory.Build.props Directory.Packages.props VumaRetail.sln ./
COPY src/VumaRetail.Application/VumaRetail.Application.csproj src/VumaRetail.Application/
COPY src/VumaRetail.CloudApi/VumaRetail.CloudApi.csproj src/VumaRetail.CloudApi/
COPY src/VumaRetail.Contracts/VumaRetail.Contracts.csproj src/VumaRetail.Contracts/
COPY src/VumaRetail.ControlPlane/VumaRetail.ControlPlane.csproj src/VumaRetail.ControlPlane/
COPY src/VumaRetail.Domain/VumaRetail.Domain.csproj src/VumaRetail.Domain/
COPY src/VumaRetail.Finance/VumaRetail.Finance.csproj src/VumaRetail.Finance/
COPY src/VumaRetail.Hardware/VumaRetail.Hardware.csproj src/VumaRetail.Hardware/
COPY src/VumaRetail.Imports/VumaRetail.Imports.csproj src/VumaRetail.Imports/
COPY src/VumaRetail.Infrastructure/VumaRetail.Infrastructure.csproj src/VumaRetail.Infrastructure/
COPY src/VumaRetail.Licensing/VumaRetail.Licensing.csproj src/VumaRetail.Licensing/
COPY src/VumaRetail.PublicApi/VumaRetail.PublicApi.csproj src/VumaRetail.PublicApi/
COPY src/VumaRetail.Sync/VumaRetail.Sync.csproj src/VumaRetail.Sync/
COPY src/VumaRetail.Web/VumaRetail.Web.csproj src/VumaRetail.Web/
COPY src/VumaRetail.Workflow/VumaRetail.Workflow.csproj src/VumaRetail.Workflow/
RUN dotnet restore src/VumaRetail.CloudApi/VumaRetail.CloudApi.csproj
COPY src ./src
RUN dotnet publish src/VumaRetail.CloudApi/VumaRetail.CloudApi.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
RUN useradd --system --uid 10001 --create-home vuma
WORKDIR /app
COPY --from=build --chown=vuma:vuma /app/publish .
USER vuma
ENV ASPNETCORE_URLS=http://+:10000
EXPOSE 10000
# TLS NOTE: This container listens on plain HTTP (port 10000). In production, TLS MUST be terminated
# at the reverse proxy layer (Render, nginx, Caddy, AWS ALB, etc.). Never expose port 10000 directly
# to the internet without a TLS-terminating proxy in front.
# For Kestrel-direct HTTPS (non-Render deployments), configure ASPNETCORE_URLS=https://+:10000 and
# Kestrel__Endpoints__Https__Certificate__Path=/certs/server.pfx plus its secret password.
ENTRYPOINT ["sh", "-c", "dotnet VumaRetail.CloudApi.dll --urls http://0.0.0.0:${PORT:-10000}"]

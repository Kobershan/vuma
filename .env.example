# Vuma Retail — environment template. Placeholders only, never real values (CLAUDE.md §1).
#
# Copy to .env (git-ignored) or set these in the environment. Every one of them also has an
# appsettings equivalent; the environment form is what the Windows Service and the containerised
# cloud API use. Double underscore is the .NET configuration separator.

# ---- Store server database (PostgreSQL 16) -----------------------------------------------------
ConnectionStrings__Vuma=Host=localhost;Port=5432;Database=vuma;Username=vuma;Password=REPLACE_ME

# ---- The tenant and store this host serves -----------------------------------------------------
# A store server serves exactly one tenant and is set from its activation record (Stage 04b).
# Left empty in the cloud, where every request carries its own tenant.
Vuma__Host__TenantId=00000000-0000-0000-0000-000000000000
# Vuma__Host__StoreId=00000000-0000-0000-0000-000000000000

# ---- JWT (docs/SECURITY.md §1) -----------------------------------------------------------------
# At least 32 bytes of real entropy. The host REFUSES TO START on the shipped placeholder outside
# Development — a shared default signing key is a master key for every installation that used it.
#   openssl rand -base64 48
Vuma__Jwt__SigningKey=REPLACE_ME_WITH_AT_LEAST_32_BYTES_OF_ENTROPY
Vuma__Jwt__Issuer=vuma-store-server
Vuma__Jwt__Audience=vuma
Vuma__Jwt__AccessTokenLifetime=00:15:00
Vuma__Jwt__RefreshTokenLifetime=30.00:00:00

# ---- Production transport (required outside Development) --------------------------------------
# The host refuses to start unless the public HTTPS endpoint exists and the store's terminal-only
# endpoint requires a client certificate. Supply certificate paths/passwords through the deployment
# secret store; do not put private keys in this file.
Kestrel__Endpoints__Https__Url=https://0.0.0.0:8443
Kestrel__Endpoints__Https__Certificate__Path=REPLACE_ME
Kestrel__Endpoints__Https__Certificate__Password=REPLACE_ME
Kestrel__Endpoints__TerminalHttps__Url=https://0.0.0.0:8444
Kestrel__Endpoints__TerminalHttps__ClientCertificateMode=RequireCertificate
Kestrel__Endpoints__TerminalHttps__Certificate__Path=REPLACE_ME
Kestrel__Endpoints__TerminalHttps__Certificate__Password=REPLACE_ME

# ---- Encrypted backups (required outside Development) ------------------------------------------
# Exactly 32 random bytes encoded as base64. Rotate through an approved secret/KMS process and keep
# the old key available until all snapshots encrypted with it have expired.
#   openssl rand -base64 32
Vuma__Backup__Encryption__Key=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# ---- Integration tests -------------------------------------------------------------------------
# Optional. When set and reachable it is preferred over Testcontainers (ADR-036).
# scripts/pg-test.sh prints the value to use.
# VUMA_TEST_POSTGRES=Host=127.0.0.1;Port=55432;Database=postgres;Username=vuma;Password=vuma

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
max_line_length = 120

# ---- using directives ----
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ---- namespaces ----
csharp_style_namespace_declarations = file_scoped:warning

# ---- var ----
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# ---- expression preferences ----
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion

# ---- null checking ----
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# ---- modifiers ----
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning
dotnet_style_readonly_field = true:warning

# ---- naming: interfaces are IPascalCase ----
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# ---- naming: private fields are _camelCase ----
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ---- naming: everything else public is PascalCase ----
dotnet_naming_rule.public_members_pascal.severity = warning
dotnet_naming_rule.public_members_pascal.symbols = public_symbols
dotnet_naming_rule.public_members_pascal.style = pascal
dotnet_naming_symbols.public_symbols.applicable_kinds = class,struct,enum,property,method,event,delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public,internal,protected
dotnet_naming_style.pascal.capitalization = pascal_case

# ---- analyzer severities that back the conventions ----
# CA1062 null-check public arguments — Domain/Application treat this as an error via TreatWarningsAsErrors
dotnet_diagnostic.CA1062.severity = warning
# CA2007 ConfigureAwait — irrelevant in ASP.NET Core, noisy in WPF where we want the context
dotnet_diagnostic.CA2007.severity = none
# CS1591 missing XML doc on public members — required by §7 rule 11 on the API surface
dotnet_diagnostic.CS1591.severity = warning

[tests/**/*.cs]
# Test method names read as sentences, and XML docs are not required on them.
dotnet_diagnostic.CS1591.severity = none
dotnet_naming_rule.public_members_pascal.severity = none

[src/**/Migrations/*.cs]
# EF Core scaffolds these from a fixed template. Holding generated code to the hand-written-code
# rules produces a warning per migration, forever, that nobody can act on without editing a file
# `dotnet ef` will overwrite — and a permanently noisy build is how a real warning gets missed.
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CS1591.severity = none

[src/**/Migrations/**/*.cs]
# The same exemption, one level deeper: Stage 06c gives the registry its own migration chain in a
# `Migrations/Registry/` subfolder (ADR-117 — a separate chain, migrated first). `Migrations/*.cs`
# above and `Migrations/**/*.cs` here are both needed — in this editorconfig glob dialect, `**` requires
# at least one directory segment, so neither pattern alone covers both a flat chain and a nested one.
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CS1591.severity = none

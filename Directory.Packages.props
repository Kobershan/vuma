<Project>

  <!--
    Central package management: one version of every dependency across the whole
    solution. Individual .csproj files carry <PackageReference Include="..." />
    with NO Version attribute — the version lives here and only here.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <!--
      snake_case is not a preference: PostgreSQL folds unquoted identifiers to lower case, so
      PascalCase names mean quoted identifiers in every hand-written query forever
      (CONVENTIONS.md §2). This package applies the convention once, model-wide.
    -->
    <PackageVersion Include="EFCore.NamingConventions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <!-- Stage 04: the outbox dispatcher is an IHostedService (CLAUDE.md §4, background work). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <!-- Stage 04: the store server's HTTP sync transport to the cloud. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Sync and backup">
    <!--
      CLAUDE.md §4: S3-compatible object storage via the AWS SDK, which also drives Backblaze B2,
      Wasabi and MinIO through a ServiceURL plus path-style addressing. Nothing in CI has a bucket,
      so FileSystemBackupVault is the tested default and this is the production adapter.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102" />
  </ItemGroup>

  <ItemGroup Label="Licensing">
    <!--
      Ed25519 licence and lease signatures (docs/LICENSING.md §2, ADR-026). .NET 9's
      System.Security.Cryptography has no Ed25519 primitive, and this is the one dependency that
      supplies it without a native library: MIT-licensed, pure managed, and therefore fine inside a
      WPF till and a WiX bundle. See ADR-050 for why not NSec and why not a substitute curve.
    -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <!-- CLAUDE.md §4. Validators are declared in Stage 02; Stage 03 runs them in the pipeline. -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
  </ItemGroup>

  <ItemGroup Label="Data import">
    <!--
      Stage 11, both locked by CLAUDE.md §4 rather than chosen here (ADR-077).

      ClosedXML reads and writes OOXML with no Excel installed and no native dependency, which is what
      a Windows service and a Linux CI container both need. It is also the writer the tests use to
      build an .xlsx in-memory and read it straight back, so the reader is asserted against a real
      workbook rather than against a fixture nobody can regenerate.

      PdfPig gives words with their bounding boxes, which is the whole reason a PDF price list is
      readable at all: rows come from baselines and columns from x-positions. Its PdfDocumentBuilder
      writes the fixtures the reader tests parse. A scanned PDF has no text layer and is refused
      rather than guessed at — Tesseract is deferred behind IOcrTextExtractor, see PROGRESS.md.
    -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup Label="API platform">
    <!--
      ADR-009 names Scrutor by name: the dispatcher is ours, the assembly scan that finds handlers
      for it is not worth writing twice.
    -->
    <PackageVersion Include="Scrutor" Version="6.1.0" />
    <!--
      The OpenAPI document generator built into ASP.NET Core 9 — no Swashbuckle, no NSwag. It serves
      /openapi/v1.json, which is the path CLAUDE.md §8's Definition of Done names.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <!--
      CLAUDE.md §4: Serilog to a rolling file, and later OTLP to the cloud. Serilog.AspNetCore
      carries the console, file and compact-JSON pieces, so one reference covers the sinks.
    -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <!--
      Stage 04 completes the CLAUDE.md §4 logging row: Serilog → rolling file AND OTLP → cloud. Off
      unless Vuma:Telemetry:Otlp:Endpoint is configured — R10 caps what may leave a tenant's premises.
    -->
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup Label="Identity and tokens">
    <!--
      ASP.NET Core Identity's core, for PasswordHasher only — the PBKDF2-HMAC-SHA512 implementation
      that CLAUDE.md §4 names. The EF stores, UserManager and IdentityDbContext are deliberately not
      used; see ADR-038 for why users are Vuma entities instead.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="9.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.3.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      FluentAssertions is pinned to 6.x deliberately. Version 8 moved to a paid
      commercial licence, and Vuma is proprietary commercial software. 6.12.2 is
      the last Apache-2.0 line. Do not "upgrade" this without reading ADR-032.
    -->
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!--
      Testcontainers is the documented path (TESTING.md §2) and is used whenever Docker is present.
      VUMA_TEST_POSTGRES overrides it for CI service containers and for developer machines with a
      local PostgreSQL but no Docker. See ADR-036.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <!-- docs/TESTING.md §1's API level: routing, auth, validation, ProblemDetails and OpenAPI. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageVersion Include="Npgsql" Version="9.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <!-- ADR-039: pin SSH.NET to non-vulnerable version; 2024.1.0 has high-severity GHSA-q939-rpr3-3284. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Handler and mapping tests against a real PostgreSQL with real migrations
    (docs/TESTING.md §2). A mocked DbContext proves nothing about a query that
    has to run against Postgres, a global query filter, or a bytea concurrency
    token — which is most of what Stage 01 built.
  -->

  <PropertyGroup>
    <RootNamespace>ZenithRetail.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZenithRetail.Domain\ZenithRetail.Domain.csproj" />
    <ProjectReference Include="..\..\src\ZenithRetail.Application\ZenithRetail.Application.csproj" />
    <ProjectReference Include="..\..\src\ZenithRetail.Infrastructure\ZenithRetail.Infrastructure.csproj" />
    <!-- Stage 02: the authenticated IPrincipalAccessor is what makes R6's audit trail name a person. -->
    <ProjectReference Include="..\..\src\ZenithRetail.Web\ZenithRetail.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="ZenithRetail.Infrastructure.Persistence" />
  </ItemGroup>

</Project>

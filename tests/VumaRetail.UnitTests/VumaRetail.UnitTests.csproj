<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>VumaRetail.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VumaRetail.Domain\VumaRetail.Domain.csproj" />
    <ProjectReference Include="..\..\src\VumaRetail.Application\VumaRetail.Application.csproj" />
    <!--
      Stage 04. The hybrid logical clock and the conflict resolver are pure protocol over Application
      ports, so they belong at this level: no database, no host, and every case a table.
    -->
    <ProjectReference Include="..\..\src\VumaRetail.Sync\VumaRetail.Sync.csproj" />
    <!-- Stage 04b: the enforcement ladder, the fingerprint matcher and the signed documents. -->
    <ProjectReference Include="..\..\src\VumaRetail.Licensing\VumaRetail.Licensing.csproj" />
    <!--
      Stage 07. The posting rules engine, the tax engine, the variance checker and the ageing
      bucketer are all pure decisions over Application ports — the accounting rules that must hold
      regardless of what the database does, so they are asserted here rather than through EF.
    -->
    <ProjectReference Include="..\..\src\VumaRetail.Finance\VumaRetail.Finance.csproj" />
    <!--
      Stage 09. The receipt layout, the ESC/POS byte stream and the embedded-weight barcode reader are
      pure functions with no device in the room — which is exactly why they belong here, and why they
      are testable on the Linux machine this repository is built on for a printer that only exists on
      a shop counter.
    -->
    <ProjectReference Include="..\..\src\VumaRetail.Hardware\VumaRetail.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>

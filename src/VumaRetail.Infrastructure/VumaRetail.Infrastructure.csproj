<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core, repositories, outbox and integrations. Added in Stage 01. -->

  <PropertyGroup>
    <RootNamespace>VumaRetail.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VumaRetail.Application\VumaRetail.Application.csproj" />
    <ProjectReference Include="..\VumaRetail.Contracts\VumaRetail.Contracts.csproj" />
    <!--
      Stage 04. VumaRetail.Sync is the replication protocol expressed against Application ports and
      nothing else — no EF, no HTTP, no S3 — so it sits below this project rather than beside it.
      Infrastructure supplies its adapters: the EF replica writer, the HTTP transport, the vault.
    -->
    <ProjectReference Include="..\VumaRetail.Sync\VumaRetail.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      Stage 03's pipeline: FluentValidation is run by ValidationBehaviour over the validators
      Application declares, and Scrutor is the assembly scan ADR-009 names.
    -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Scrutor" />
    <!--
      ASP.NET Core Identity's PasswordHasher only — not the EF stores, not UserManager, not
      IdentityDbContext. ADR-038 explains why Vuma's users are Vuma entities.
    -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <!--
      Stage 04: the store server's HTTP sync transport, and the S3-compatible backup vault
      CLAUDE.md §4 names.
    -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="AWSSDK.S3" />
    <!--
      Design-time only: `dotnet ef migrations add` needs it, the store server does not ship it.
      PrivateAssets keeps it out of the transitive graph of anything that references us.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>

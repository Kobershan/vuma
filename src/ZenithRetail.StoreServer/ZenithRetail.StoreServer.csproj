<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The in-store server: ASP.NET Core Minimal APIs hosted as a Windows Service.
    This is the source of truth for the store (R2) and must keep the tills
    trading with no internet (R1).
  -->

  <PropertyGroup>
    <RootNamespace>ZenithRetail.StoreServer</RootNamespace>
    <UserSecretsId>zenith-storeserver</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenithRetail.Infrastructure\ZenithRetail.Infrastructure.csproj" />
    <ProjectReference Include="..\ZenithRetail.Sync\ZenithRetail.Sync.csproj" />
  </ItemGroup>

</Project>

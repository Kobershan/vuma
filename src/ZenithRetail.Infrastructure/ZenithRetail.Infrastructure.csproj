<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core, repositories, outbox and integrations. Added in Stage 01. -->

  <PropertyGroup>
    <RootNamespace>ZenithRetail.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenithRetail.Application\ZenithRetail.Application.csproj" />
    <ProjectReference Include="..\ZenithRetail.Contracts\ZenithRetail.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      Design-time only: `dotnet ef migrations add` needs it, the store server does not ship it.
      PrivateAssets keeps it out of the transitive graph of anything that references us.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>

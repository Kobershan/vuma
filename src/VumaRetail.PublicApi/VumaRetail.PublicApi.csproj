<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ADR-021 / CLAUDE.md §7 rule 14 — READ THIS BEFORE ADDING A REFERENCE.

    This host faces the open internet and untrusted partners (storefronts,
    loyalty coalitions). It has its own DTOs on purpose: cost, margin, supplier
    and other-customer data must be *structurally unreachable*, not filtered at
    runtime. A forgotten filter is a leak; an absent property cannot leak.

    It therefore must NOT reference VumaRetail.Contracts, and must not
    reference Domain entities directly. The architecture tests fail the build if
    it does. Reaching data goes through the Application layer and gets mapped
    into a public DTO defined in this project.

    ADR-151 (Stage 20): this assembly holds the public DTOs, endpoint mappings and
    surface middleware (rate limiting, neutral read-only). The routes are served by a
    host with persistence — today the store server via MapVumaLoyaltyPublic — while the
    standalone API-key/member-token deployable follows with Stage 30b's auth. There is
    deliberately no Program.cs: this project is not runnable on its own yet.
  -->

  <PropertyGroup>
    <RootNamespace>VumaRetail.PublicApi</RootNamespace>
    <UserSecretsId>vuma-publicapi</UserSecretsId>
    <!-- ADR-151: contract + mapping assembly in Stage 20, not yet a runnable host. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project is a contract library, not a host. Its development settings must never
         compete with the StoreServer host settings in a published service bundle. -->
    <Content Update="appsettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <ProjectReference Include="..\VumaRetail.Application\VumaRetail.Application.csproj" />
  </ItemGroup>

</Project>

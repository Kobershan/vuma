{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "REPLACE_WITH_HOSTNAME_OR_*_FOR_LOCAL_DEV",
  "ConnectionStrings": {
    "Vuma": "Host=localhost;Port=5432;Database=vuma_cloud;Username=vuma;Password=CHANGE_ME",
    "Registry": "Host=localhost;Port=5432;Database=vuma_registry;Username=vuma;Password=CHANGE_ME"
  },
  "Vuma": {
    "Host": {
      "//": "Deliberately empty. The cloud tier serves every tenant, so a request must carry its own — a pinned tenant here would make the store server's mistake the cloud's data.",
      "TenantId": "00000000-0000-0000-0000-000000000000",
      "StoreId": null
    },
    "Jwt": {
      "Issuer": "vuma-cloud",
      "Audience": "vuma",
      "SigningKey": "development-only-signing-key-replace-me-0000000000",
      "AccessTokenLifetime": "00:05:00",
      "RefreshTokenLifetime": "30.00:00:00"
    },
    "Sync": {
      "Node": {
        "NodeId": "cloud",
        "Kind": "Cloud"
      }
    },
    "Loyalty": {
      "Public": {
        "WebhookSecret": "REPLACE_WITH_WEBHOOK_SECRET"
      }
    },
    "Backup": {
      "Vault": {
        "Provider": "FileSystem",
        "Directory": "backups"
      },
      "Encryption": {
        "Key": ""
      },
      "Postgres": {
        "ToolDirectory": "",
        "Timeout": "02:00:00"
      }
    },
    "Telemetry": {
      "Otlp": {
        "Endpoint": ""
      }
    }
  }
}

<Window x:Class="VumaRetail.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vuma Retail" Width="1200" Height="760" MinWidth="960" MinHeight="640">
  <Grid Margin="24">
    <StackPanel>
      <TextBlock Text="Vuma Retail" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="Operations dashboard" Margin="0,8,0,24" />
      <Border Padding="20" CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}">
        <StackPanel>
          <TextBlock Text="Desktop client ready" FontSize="20" />
          <TextBlock Text="Connect this client to the Cloud API using the configured tenant endpoint." Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="VumaRetail.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vuma Retail" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="#0A0A0C" Foreground="#F5F5F7" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Sidebar" Color="#111113" />
    <SolidColorBrush x:Key="Surface" Color="#171719" />
    <SolidColorBrush x:Key="Muted" Color="#98989F" />
    <SolidColorBrush x:Key="Accent" Color="#B5F36A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#25331D" />
    <SolidColorBrush x:Key="Border" Color="#2B2B2F" />
    <Style x:Key="SidebarButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#B8B8BF" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" /><Setter Property="Margin" Value="8,2" /><Setter Property="FontSize" Value="14" />
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#222225" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#B5F36A" /><Setter Property="Foreground" Value="#10120D" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,11" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background" Value="#171719" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#38383D" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="MetricCard" TargetType="Border">
      <Setter Property="BorderBrush" Value="#2B2B2F" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid x:Name="LoginView">
      <Border Width="440" Padding="36" Background="#111113" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="vuma" FontSize="42" FontWeight="Bold" Foreground="{StaticResource Accent}" />
          <TextBlock Text="Retail operations, beautifully connected." FontSize="20" Margin="0,8,0,28" />
          <TextBlock Text="API endpoint" Foreground="{StaticResource Muted}" Margin="0,0,0,6" /><TextBox x:Name="ApiUrlInput" Style="{StaticResource Input}" Text="https://localhost:7243/api/v1" />
          <TextBlock Text="Username" Foreground="{StaticResource Muted}" Margin="0,18,0,6" /><TextBox x:Name="UsernameInput" Style="{StaticResource Input}" />
          <TextBlock Text="Password" Foreground="{StaticResource Muted}" Margin="0,14,0,6" /><PasswordBox x:Name="PasswordInput" Background="#171719" Foreground="White" BorderBrush="#38383D" Padding="12,10" />
          <TextBlock x:Name="LoginError" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,14,0,0" />
          <Button Content="Sign in securely" Style="{StaticResource PrimaryButton}" Click="SignIn_Click" Margin="0,24,0,0" />
          <TextBlock Text="Credentials remain in this session and are never sent to PostgreSQL." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="DashboardView" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="252" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="18,24,18,26"><TextBlock Text="vuma" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}" /><TextBlock Text="RETAIL OS" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="2,2,0,0" /></StackPanel>
          <StackPanel>
            <TextBlock Text="WORKSPACE" Foreground="#67676D" FontSize="10" FontWeight="SemiBold" Margin="22,0,0,6" />
            <Button Content="⌂   Overview" Tag="Overview" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="▣   Point of sale" Tag="POS" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="□   Inventory" Tag="Inventory" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="≡   Orders" Tag="Orders" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="⇄   Procurement" Tag="Procurement" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="↗   Logistics" Tag="Logistics" Style="{StaticResource SidebarButton}" Click="Navigate_Click" />
            <TextBlock Text="BUSINESS" Foreground="#67676D" FontSize="10" FontWeight="SemiBold" Margin="22,22,0,6" />
            <Button Content="▤   Finance" Tag="Finance" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="♡   Customers &amp; CRM" Tag="CRM" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="◆   Manufacturing" Tag="Manufacturing" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="✦   Loyalty" Tag="Loyalty" Style="{StaticResource SidebarButton}" Click="Navigate_Click" />
            <TextBlock Text="CONTROL" Foreground="#67676D" FontSize="10" FontWeight="SemiBold" Margin="22,22,0,6" />
            <Button Content="⚙   Administration" Tag="Administration" Style="{StaticResource SidebarButton}" Click="Navigate_Click" /><Button Content="↻   Sync &amp; backups" Tag="Sync" Style="{StaticResource SidebarButton}" Click="Navigate_Click" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="#19191C" CornerRadius="12" Margin="14" Padding="12"><StackPanel><TextBlock Text="CONNECTED" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="ConnectedEndpoint" Text="API" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></Border>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="34,28,40,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,28"><StackPanel><TextBlock x:Name="PageEyebrow" Text="OPERATIONS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" /><TextBlock x:Name="PageTitle" Text="Good morning" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock x:Name="PageSubtitle" Text="Everything important, at a glance." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,7,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Refresh" Click="Refresh_Click" Background="#222225" Foreground="White" BorderThickness="0" Padding="16,10" Margin="0,0,10,0" /><Button Content="New sale" Style="{StaticResource PrimaryButton}" Click="NewSale_Click" /></StackPanel></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Grid x:Name="OverviewPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Background="{StaticResource Surface}"><StackPanel><TextBlock Text="Sales today" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SalesToday" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Text="Live from your store" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Background="{StaticResource Surface}"><StackPanel><TextBlock Text="Orders today" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OrdersToday" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Text="Across all channels" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}" Background="{StaticResource Surface}"><StackPanel><TextBlock Text="Open orders" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OpenOrders" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Text="Need attention" Foreground="#FFCC66" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Background="{StaticResource AccentSoft}"><StackPanel><TextBlock Text="System status" Foreground="{StaticResource Muted}"/><TextBlock Text="Healthy" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,13,0,0"/><TextBlock Text="API and database online" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
          </Grid>
          <Grid x:Name="ActivityPanel" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,10,0"><StackPanel><TextBlock Text="Recent activity" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Your latest sales and order movement." Foreground="{StaticResource Muted}" Margin="0,7,0,20"/><TextBlock x:Name="RecentActivity" Text="Sign in and refresh to load live activity." Foreground="#C8C8CE" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="10,0,0,0"><StackPanel><TextBlock Text="Quick actions" FontSize="19" FontWeight="SemiBold"/><Button Content="Open point of sale" Tag="POS" Style="{StaticResource SidebarButton}" Click="Navigate_Click" Margin="-6,18,0,0"/><Button Content="Check inventory" Tag="Inventory" Style="{StaticResource SidebarButton}" Click="Navigate_Click" Margin="-6,2,0,0"/><Button Content="View orders" Tag="Orders" Style="{StaticResource SidebarButton}" Click="Navigate_Click" Margin="-6,2,0,0"/><Button Content="Open finance" Tag="Finance" Style="{StaticResource SidebarButton}" Click="Navigate_Click" Margin="-6,2,0,0"/></StackPanel></Border></Grid>
          <Border x:Name="ModulePanel" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,22,0,0"><StackPanel><TextBlock x:Name="ModuleTitle" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ModuleDescription" Foreground="{StaticResource Muted}" Margin="0,8,0,22" TextWrapping="Wrap"/><TextBlock Text="Available API capabilities" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock x:Name="ModuleCapabilities" Foreground="#C8C8CE" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="24"/></StackPanel></Border>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,20,0,20" />
        </StackPanel></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>

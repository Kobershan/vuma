<Window x:Class="VumaRetail.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vuma Till"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        Background="{DynamicResource VumaSurfaceSunkenBrush}"
        Foreground="{DynamicResource VumaTextPrimaryBrush}">
  <Window.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource VumaSurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VumaTextTertiaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource VumaRadiusLg}" />
      <Setter Property="Padding" Value="{DynamicResource VumaInset24}" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VumaTextSecondaryBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource VumaTypeCaptionFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource VumaTypeCaptionSize}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VumaTypeBodyFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource VumaTypeBodySize}" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource VumaAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VumaSurfaceSunkenBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource VumaInset16}" />
      <Setter Property="FontFamily" Value="{DynamicResource VumaTypeHeadlineFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource VumaTypeHeadlineSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="{DynamicResource VumaTouchPosSecondary}" />
    </Style>
    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource VumaSurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VumaTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VumaTextTertiaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="{DynamicResource VumaTypeTitle2Size}" />
    </Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource VumaSurfaceSunkenBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource VumaTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VumaTextTertiaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{DynamicResource VumaInset12}" />
      <Setter Property="FontFamily" Value="{DynamicResource VumaTypeBodyFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource VumaTypeBodySize}" />
    </Style>
  </Window.Resources>
  <Grid Margin="{DynamicResource VumaInset24}">
    <Grid x:Name="PinLoginView" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Style="{StaticResource Panel}">
        <StackPanel>
          <TextBlock Text="VUMA" FontFamily="{DynamicResource VumaTypeDisplayFamily}"
                     FontSize="{DynamicResource VumaTypeDisplaySize}" FontWeight="Bold"
                     Foreground="{DynamicResource VumaAccentBrush}" />
          <TextBlock Text="Till sign-in" FontFamily="{DynamicResource VumaTypeTitle1Family}"
                     FontSize="{DynamicResource VumaTypeTitle1Size}" FontWeight="SemiBold"
                     Margin="{DynamicResource VumaInset8}" />
          <TextBlock x:Name="StoreNameText" Text="Store" Style="{StaticResource Body}"
                     Margin="{DynamicResource VumaInset8}" />
          <TextBlock x:Name="TerminalText" Text="Terminal —" Style="{StaticResource Label}"
                     Margin="{DynamicResource VumaInset4}" />
          <TextBlock x:Name="ConnectionText" Text="Checking connection…" Style="{StaticResource Label}"
                     Margin="{DynamicResource VumaInset16}" />
          <TextBlock Text="Enter your 4–8 digit PIN" Style="{StaticResource Label}" />
          <TextBox x:Name="PinDisplay" Style="{StaticResource Input}" IsReadOnly="True"
                   HorizontalContentAlignment="Center" FontFamily="{DynamicResource VumaTypeMonoFamily}"
                   FontSize="{DynamicResource VumaTypeTitle1Size}" Margin="{DynamicResource VumaInset8}" />
          <UniformGrid Columns="3" Margin="{DynamicResource VumaInset12}">
            <Button Content="1" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="1" />
            <Button Content="2" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="2" />
            <Button Content="3" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="3" />
            <Button Content="4" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="4" />
            <Button Content="5" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="5" />
            <Button Content="6" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="6" />
            <Button Content="7" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="7" />
            <Button Content="8" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="8" />
            <Button Content="9" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="9" />
            <Button Content="Clear" Style="{StaticResource KeyButton}" Click="ClearPin_Click" />
            <Button Content="0" Style="{StaticResource KeyButton}" Click="PinKey_Click" Tag="0" />
            <Button Content="⌫" Style="{StaticResource KeyButton}" Click="BackspacePin_Click" />
          </UniformGrid>
          <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Click="SignIn_Click"
                  Margin="{DynamicResource VumaInset12}" />
          <TextBlock x:Name="LoginError" Style="{StaticResource Label}" TextWrapping="Wrap"
                     Foreground="{DynamicResource VumaCriticalBrush}" Margin="{DynamicResource VumaInset8}" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="TillView" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="{DynamicResource VumaInset12}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock x:Name="StatusOperator" Style="{StaticResource Body}" Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="StatusConnection" Style="{StaticResource Label}" Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="StatusClock" Style="{StaticResource Label}" Margin="{DynamicResource VumaInset8}" />
          </StackPanel>
          <TextBlock Text="VUMA TILL" FontFamily="{DynamicResource VumaTypeTitle2Family}"
                     FontSize="{DynamicResource VumaTypeTitle2Size}" FontWeight="SemiBold" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="{DynamicResource VumaInset12}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="{DynamicResource VumaInset8}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <TextBox x:Name="SearchInput" Style="{StaticResource Input}"
                       KeyDown="SearchInput_KeyDown" ToolTip="Barcode or item search" />
              <TextBox x:Name="QuantityInput" Style="{StaticResource Input}"
                       Text="1" Margin="{DynamicResource VumaInset8}" ToolTip="Quantity" />
              <TextBox x:Name="UnitPriceInput" Style="{StaticResource Input}"
                       Text="0" ToolTip="Unit price" />
              <Button Content="Add line" Style="{StaticResource PrimaryButton}" Click="AddLine_Click"
                      Margin="{DynamicResource VumaInset8}" />
            </StackPanel>
            <DataGrid x:Name="LinesList" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                      Margin="{DynamicResource VumaInset8}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" />
                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" />
                <DataGridTextColumn Header="VAT" Binding="{Binding Tax, StringFormat=N2}" />
                <DataGridTextColumn Header="Total" Binding="{Binding Gross, StringFormat=N2}" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Void selected" Style="{StaticResource KeyButton}" Click="VoidLine_Click"
                      Margin="{DynamicResource VumaInset8}" />
              <Button Content="Park" Style="{StaticResource KeyButton}" Click="ParkSale_Click" />
              <Button Content="Parked" Style="{StaticResource KeyButton}" Click="Parked_Click"
                      Margin="{DynamicResource VumaInset8}" />
              <Button Content="New sale" Style="{StaticResource KeyButton}" Click="NewSale_Click"
                      Margin="{DynamicResource VumaInset8}" />
              <Button Content="Tender" Style="{StaticResource PrimaryButton}" Click="Tender_Click" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="{DynamicResource VumaInset8}">
          <StackPanel>
            <TextBlock Text="Current sale" Style="{StaticResource Label}" />
            <TextBlock x:Name="SaleNumberText" Text="Not started" FontFamily="{DynamicResource VumaTypeTitle2Family}"
                       FontSize="{DynamicResource VumaTypeTitle2Size}" FontWeight="SemiBold"
                       Margin="{DynamicResource VumaInset8}" />
            <TextBlock Text="NET" Style="{StaticResource Label}" />
            <TextBlock x:Name="NetText" Text="0.00" Style="{StaticResource Body}" />
            <TextBlock Text="VAT" Style="{StaticResource Label}" Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="TaxText" Text="0.00" Style="{StaticResource Body}" />
            <TextBlock Text="TOTAL" Style="{StaticResource Label}" Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="GrossText" Text="0.00" FontFamily="{DynamicResource VumaTypeDisplayFamily}"
                       FontSize="{DynamicResource VumaTypeDisplaySize}" FontWeight="Bold"
                       Foreground="{DynamicResource VumaAccentBrush}" />
            <TextBlock x:Name="TillError" Style="{StaticResource Label}" TextWrapping="Wrap"
                       Foreground="{DynamicResource VumaCriticalBrush}" Margin="{DynamicResource VumaInset16}" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="{DynamicResource VumaInset8}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Cash up" Style="{StaticResource KeyButton}" Click="CashUp_Click" />
            <TextBlock x:Name="StatusSync" Text="Sync queue 0" Style="{StaticResource Label}" Margin="{DynamicResource VumaInset8}" />
          </StackPanel>
          <TextBlock Text="UTC-backed clock · REST terminal" Style="{StaticResource Label}" HorizontalAlignment="Right" />
        </DockPanel>
      </Border>
      <Border x:Name="TenderView" Visibility="Collapsed" Grid.RowSpan="3"
              Background="{DynamicResource VumaSurfaceSunkenBrush}" Padding="{DynamicResource VumaInset24}">
        <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Tender" FontFamily="{DynamicResource VumaTypeTitle1Family}"
                       FontSize="{DynamicResource VumaTypeTitle1Size}" FontWeight="SemiBold" />
            <TextBlock Text="Split tender is recorded one immutable payment at a time."
                       Style="{StaticResource Label}" Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="TenderDueText" Text="Remaining 0.00" Style="{StaticResource Body}"
                       Margin="{DynamicResource VumaInset8}" />
            <ComboBox x:Name="TenderTypeInput" SelectedIndex="0" Margin="{DynamicResource VumaInset8}">
              <ComboBoxItem Content="Cash" />
              <ComboBoxItem Content="Card" />
              <ComboBoxItem Content="Voucher" />
              <ComboBoxItem Content="MobileMoney" />
              <ComboBoxItem Content="CustomerAccount" />
            </ComboBox>
            <TextBox x:Name="TenderAmountInput" Style="{StaticResource Input}" Text="0"
                     Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="ChangeDueText" Text="Change due 0.00" Style="{StaticResource Body}"
                       Foreground="{DynamicResource VumaPositiveBrush}" Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="TenderError" Style="{StaticResource Label}" TextWrapping="Wrap"
                       Foreground="{DynamicResource VumaCriticalBrush}" Margin="{DynamicResource VumaInset8}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Back" Style="{StaticResource KeyButton}" Click="TenderBack_Click" />
              <Button Content="Add tender" Style="{StaticResource KeyButton}" Click="AddTender_Click"
                      Margin="{DynamicResource VumaInset8}" />
              <Button Content="Complete sale" Style="{StaticResource PrimaryButton}" Click="CompleteSale_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
      <Border x:Name="ReceiptView" Visibility="Collapsed" Grid.RowSpan="3"
              Background="{DynamicResource VumaSurfaceSunkenBrush}" Padding="{DynamicResource VumaInset24}">
        <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Receipt preview" FontFamily="{DynamicResource VumaTypeTitle1Family}"
                       FontSize="{DynamicResource VumaTypeTitle1Size}" FontWeight="SemiBold" />
            <ScrollViewer Grid.Row="1" Margin="{DynamicResource VumaInset12}">
              <TextBlock x:Name="ReceiptText" FontFamily="{DynamicResource VumaTypeMonoFamily}"
                         FontSize="{DynamicResource VumaTypeMonoSize}" TextWrapping="NoWrap" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Close" Style="{StaticResource KeyButton}" Click="ReceiptClose_Click" />
              <Button Content="Record print" Style="{StaticResource PrimaryButton}" Click="RecordPrint_Click"
                      Margin="{DynamicResource VumaInset8}" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>
      <Border x:Name="CashUpView" Visibility="Collapsed" Grid.RowSpan="3"
              Background="{DynamicResource VumaSurfaceSunkenBrush}" Padding="{DynamicResource VumaInset24}">
        <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Cash-up" FontFamily="{DynamicResource VumaTypeTitle1Family}"
                       FontSize="{DynamicResource VumaTypeTitle1Size}" FontWeight="SemiBold" />
            <TextBlock x:Name="ExpectedCashText" Text="Expected 0.00" Style="{StaticResource Body}"
                       Margin="{DynamicResource VumaInset8}" />
            <TextBox x:Name="CountedCashInput" Style="{StaticResource Input}" Text="0"
                     Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="CashVarianceText" Text="Variance 0.00" Style="{StaticResource Body}"
                       Margin="{DynamicResource VumaInset8}" />
            <TextBlock x:Name="CashUpError" Style="{StaticResource Label}" TextWrapping="Wrap"
                       Foreground="{DynamicResource VumaCriticalBrush}" Margin="{DynamicResource VumaInset8}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Back" Style="{StaticResource KeyButton}" Click="CashUpBack_Click" />
              <Button Content="Close shift" Style="{StaticResource PrimaryButton}" Click="CloseCashUp_Click"
                      Margin="{DynamicResource VumaInset8}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
      <Border x:Name="ParkedView" Visibility="Collapsed" Grid.RowSpan="3"
              Background="{DynamicResource VumaSurfaceSunkenBrush}" Padding="{DynamicResource VumaInset24}">
        <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Parked sales" FontFamily="{DynamicResource VumaTypeTitle1Family}"
                       FontSize="{DynamicResource VumaTypeTitle1Size}" FontWeight="SemiBold" />
            <ListBox x:Name="ParkedSalesList" DisplayMemberPath="SaleNumber"
                     Margin="{DynamicResource VumaInset12}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Close" Style="{StaticResource KeyButton}" Click="ParkedClose_Click" />
              <Button Content="Resume selected" Style="{StaticResource PrimaryButton}" Click="ResumeParked_Click"
                      Margin="{DynamicResource VumaInset8}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
</Window>

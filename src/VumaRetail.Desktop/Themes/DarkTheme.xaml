<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Generated from design/tokens.json. DO NOT EDIT BY HAND. -->
  <!-- Regenerate with: pwsh scripts/generate-tokens.ps1 -->

  <!-- Surface colours -->
  <Color x:Key="SurfaceBase">#000000</Color>
  <Color x:Key="SurfaceRaised">#141416</Color>
  <Color x:Key="SurfaceSunken">#0A0A0B</Color>

  <!-- Text colours -->
  <Color x:Key="TextPrimary">#F5F5F7</Color>
  <Color x:Key="TextSecondary">#A0A0A8</Color>
  <Color x:Key="TextTertiary">#6A6A72</Color>

  <!-- Accent and semantic colours -->
  <Color x:Key="AccentPrimary">#16A97D</Color>
  <Color x:Key="AccentQuiet">#0E2A22</Color>
  <Color x:Key="Positive">#16A97D</Color>
  <Color x:Key="Warning">#E5940A</Color>
  <Color x:Key="Critical">#FF5A4E</Color>
  <Color x:Key="Info">#4C94F0</Color>

  <Color x:Key="Separator">#2A2A2E</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{DynamicResource SurfaceBase}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaised}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource SurfaceSunken}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiary}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentPrimary}" />
  <SolidColorBrush x:Key="AccentQuietBrush" Color="{DynamicResource AccentQuiet}" />
  <SolidColorBrush x:Key="PositiveBrush" Color="{DynamicResource Positive}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource Warning}" />
  <SolidColorBrush x:Key="CriticalBrush" Color="{DynamicResource Critical}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource Info}" />
  <SolidColorBrush x:Key="SeparatorBrush" Color="{DynamicResource Separator}" />

  <!-- Typography -->
  <FontFamily x:Key="FontDisplay">Inter Display</FontFamily>
  <FontFamily x:Key="FontBody">Inter</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono</FontFamily>
  <sys:Double x:Key="FontSizeDisplay">44</sys:Double>
  <sys:Double x:Key="FontSizeTitle1">30</sys:Double>
  <sys:Double x:Key="FontSizeTitle2">22</sys:Double>
  <sys:Double x:Key="FontSizeHeadline">17</sys:Double>
  <sys:Double x:Key="FontSizeBody">15</sys:Double>
  <sys:Double x:Key="FontSizeCallout">14</sys:Double>
  <sys:Double x:Key="FontSizeCaption">12</sys:Double>
  <sys:Double x:Key="FontSizeMono">13</sys:Double>
  <FontWeight x:Key="FontWeightDisplay">600</FontWeight>
  <FontWeight x:Key="FontWeightTitle1">600</FontWeight>
  <FontWeight x:Key="FontWeightTitle2">600</FontWeight>
  <FontWeight x:Key="FontWeightHeadline">600</FontWeight>
  <FontWeight x:Key="FontWeightBody">400</FontWeight>
  <FontWeight x:Key="FontWeightCallout">400</FontWeight>
  <FontWeight x:Key="FontWeightCaption">500</FontWeight>
  <FontWeight x:Key="FontWeightMono">400</FontWeight>
  <sys:Double x:Key="LineHeightDisplay">48</sys:Double>
  <sys:Double x:Key="LineHeightTitle1">36</sys:Double>
  <sys:Double x:Key="LineHeightTitle2">28</sys:Double>
  <sys:Double x:Key="LineHeightHeadline">22</sys:Double>
  <sys:Double x:Key="LineHeightBody">21</sys:Double>
  <sys:Double x:Key="LineHeightCallout">19</sys:Double>
  <sys:Double x:Key="LineHeightCaption">16</sys:Double>
  <sys:Double x:Key="LineHeightMono">18</sys:Double>

  <!-- Spacing -->
  <sys:Double x:Key="Spacing4">4</sys:Double>
  <sys:Double x:Key="Spacing8">8</sys:Double>
  <sys:Double x:Key="Spacing12">12</sys:Double>
  <sys:Double x:Key="Spacing16">16</sys:Double>
  <sys:Double x:Key="Spacing24">24</sys:Double>
  <sys:Double x:Key="Spacing32">32</sys:Double>
  <sys:Double x:Key="Spacing48">48</sys:Double>
  <sys:Double x:Key="Spacing64">64</sys:Double>

  <!-- Radius -->
  <sys:Double x:Key="RadiusSm">8</sys:Double>
  <sys:Double x:Key="RadiusMd">12</sys:Double>
  <sys:Double x:Key="RadiusLg">16</sys:Double>
  <sys:Double x:Key="RadiusXl">22</sys:Double>
  <sys:Double x:Key="RadiusPill">999</sys:Double>

  <!-- Elevation -->
  <x:String x:Key="ElevationE1">0 1px 2px rgba(255,255,255,.06), 0 1px 1px rgba(255,255,255,.04)</x:String>
  <x:String x:Key="ElevationE2">0 8px 28px rgba(255,255,255,.06), 0 0 0 1px rgba(255,255,255,.1)</x:String>

  <!-- Motion -->
  <sys:Int32 x:Key="MotionInstantDuration">100</sys:Int32>
  <x:String x:Key="MotionInstantCurve">ease-out</x:String>
  <sys:Int32 x:Key="MotionQuickDuration">180</sys:Int32>
  <x:String x:Key="MotionQuickCurve">cubic-bezier(.2,0,0,1)</x:String>
  <sys:Int32 x:Key="MotionStandardDuration">260</sys:Int32>
  <x:String x:Key="MotionStandardCurve">cubic-bezier(.2,0,0,1)</x:String>
  <sys:Int32 x:Key="MotionVumaTickDuration">220</sys:Int32>
  <x:String x:Key="MotionVumaTickCurve">cubic-bezier(.65,0,.35,1)</x:String>

  <!-- Touch targets -->
  <sys:Double x:Key="TouchTargetPosPrimaryWidth">64</sys:Double>
  <sys:Double x:Key="TouchTargetPosPrimaryHeight">64</sys:Double>
  <sys:Double x:Key="TouchTargetPosSecondaryWidth">48</sys:Double>
  <sys:Double x:Key="TouchTargetPosSecondaryHeight">48</sys:Double>
  <sys:Double x:Key="TouchTargetBackOfficeWidth">36</sys:Double>
  <sys:Double x:Key="TouchTargetBackOfficeHeight">36</sys:Double>
  <sys:Double x:Key="TouchTargetAndroidWarehouseWidth">56</sys:Double>
  <sys:Double x:Key="TouchTargetAndroidWarehouseHeight">56</sys:Double>

  <!-- Focus -->
  <sys:Double x:Key="FocusRingWidth">2</sys:Double>
  <sys:Double x:Key="FocusRingOffset">2</sys:Double>

</ResourceDictionary>

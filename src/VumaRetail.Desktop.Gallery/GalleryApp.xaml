<Window x:Class="VumaRetail.Desktop.Gallery.GalleryApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VumaRetail.Desktop.Gallery"
        xmlns:controls="clr-namespace:VumaRetail.Desktop.Controls;assembly=VumaRetail.Desktop"
        Background="{DynamicResource SurfaceBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Content="Light" Click="OnThemeSwitch" Style="{StaticResource ButtonSecondaryStyle}" Margin="4"/>
            <Button Content="Dark" Click="OnThemeSwitch" Style="{StaticResource ButtonSecondaryStyle}" Margin="4"/>
        </StackPanel>

        <!-- Component grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ComponentGrid">
                <!-- Dynamically populated with every component in every state -->
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
